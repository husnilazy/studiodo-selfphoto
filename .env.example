# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
# Kosongkan saat development lokal: aplikasi otomatis memakai database lokal (PGlite) di folder .data
DATABASE_URL=https://mouchifvmmcaastgtmmm.supabase.co

# Rahasia untuk menandatangani sesi login. Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Google Drive (opsional) — lihat Pengaturan → Google Drive untuk langkahnya
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Isi jika URL publik tidak terdeteksi otomatis, mis. https://kasir.studiodo.id
APP_URL=

# Upload media website (logo, foto, video) ke Supabase Storage — opsional
# Supabase → Project Settings → API: Project URL, anon/publishable key, service_role key (RAHASIA)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
