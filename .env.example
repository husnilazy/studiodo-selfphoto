# Neon → `neon env pull` mengisi ini (pakai connection string POOLED untuk aplikasi)
# Kosongkan saat development lokal: aplikasi otomatis memakai database lokal (PGlite) di folder .data
DATABASE_URL=

# Rahasia untuk menandatangani sesi login. Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Google Drive (opsional) — lihat Pengaturan → Google Drive untuk langkahnya
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Isi jika URL publik tidak terdeteksi otomatis, mis. https://kasir.studiodo.id
APP_URL=

# Upload media website (logo, foto, video) ke Neon Object Storage (bucket "website") — opsional, diisi `neon env pull`
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
# Asal publik URL media (<asal>/media/<file>); kosong = asal request saat upload
MEDIA_BASE_URL=

# Sambungan ke Frameless Hub (folder hub/) — opsional
# HUB_URL = alamat Hub, HUB_API_KEY = key perusahaan STUDIODO dari Hub → Pengaturan → Sambungan API Core
# Sinkron manual: buka /api/hub/sync saat login sebagai Owner. Otomatis tiap malam lewat Vercel Cron (isi CRON_SECRET).
HUB_URL=
HUB_API_KEY=
CRON_SECRET=
