# Database: Neon Postgres.
# Neon Console → project → Connect → salin "Pooled connection" (host berakhiran -pooler), contoh:
#   postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Kosongkan saat development: Hub otomatis memakai database lokal (PGlite) di folder .data
DATABASE_URL=

# Rahasia penanda sesi login. Buat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Opsional: aktifkan analisis naratif AI (Claude). Tanpa ini, mesin rekomendasi aturan tetap jalan.
ANTHROPIC_API_KEY=
